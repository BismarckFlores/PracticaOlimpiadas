<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicaolimpiadas.controller.MainController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Cuenta bancaria" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TextField fx:id="txtAccNum" promptText="Número de cuenta"/>
    <TextField fx:id="txtOwner" promptText="Titular"/>
    <TextField fx:id="txtInitialBalance" promptText="Saldo inicial (opcional)"/>
    <Button text="Crear cuenta" onAction="#onCreateAccount"/>
    <Separator/>
    <Label fx:id="lblAccount" text="Sin cuenta"/>
    <Label fx:id="lblBalance" text="C$ 0.00" style="-fx-font-size: 16px;"/>
    <TextField fx:id="txtAmount" promptText="Monto"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Depositar" onAction="#onDeposit"/>
        <Button text="Retirar" onAction="#onWithdraw"/>
        <Button text="Consultar saldo" onAction="#onCheckBalance"/>
    </HBox>
</VBox>